{
	"name": "lokit",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"author": "king-mini",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && react-snap",
		"lint": "eslint .",
		"preview": "vite preview",
		"deploy": "npm run build && wrangler pages deploy dist --project-name=file-convert",
		"deploy:preview": "npm run build && wrangler pages deploy dist --project-name=file-convert --branch=preview"
	},
	"reactSnap": {
		"source": "dist",
		"minifyHtml": {
			"collapseWhitespace": false,
			"removeComments": false
		},
		"puppeteerArgs": [
			"--no-sandbox",
			"--disable-setuid-sandbox"
		],
		"skipThirdPartyRequests": true,
		"cacheAjaxRequests": false,
		"include": [
			"/",
			"/404.html",
			"/en",
			"/en/pdf",
			"/en/pdf/to-jpg",
			"/en/pdf/to-png",
			"/en/pdf/to-text",
			"/en/pdf/merge",
			"/en/pdf/split",
			"/en/pdf/rotate",
			"/en/pdf/compress",
			"/en/pdf/image-to-pdf",
			"/en/image",
			"/en/image/blur-background",
			"/en/image/bg-remove",
			"/en/image/resize",
			"/en/image/compress",
			"/en/image/format",
			"/en/image/crop",
			"/en/guide/blur-background",
			"/en/guide/background-remove",
			"/en/guide/image-resize",
			"/en/guide/image-compress",
			"/en/guide/format-convert",
			"/en/guide/image-crop",
			"/en/guide/pdf-to-jpg",
			"/en/guide/pdf-to-png",
			"/en/guide/pdf-to-text",
			"/en/guide/image-to-pdf",
			"/en/guide/merge-pdf",
			"/en/guide/split-pdf",
			"/en/guide/rotate-pdf",
			"/en/guide/compress-pdf",
			"/en/privacy-policy",
			"/en/terms",
			"/en/licenses",
			"/pt",
			"/pt/pdf",
			"/pt/pdf/to-jpg",
			"/pt/pdf/to-png",
			"/pt/pdf/to-text",
			"/pt/pdf/merge",
			"/pt/pdf/split",
			"/pt/pdf/rotate",
			"/pt/pdf/compress",
			"/pt/pdf/image-to-pdf",
			"/pt/image",
			"/pt/image/blur-background",
			"/pt/image/bg-remove",
			"/pt/image/resize",
			"/pt/image/compress",
			"/pt/image/format",
			"/pt/image/crop",
			"/pt/guide/blur-background",
			"/pt/guide/background-remove",
			"/pt/guide/image-resize",
			"/pt/guide/image-compress",
			"/pt/guide/format-convert",
			"/pt/guide/image-crop",
			"/pt/guide/pdf-to-jpg",
			"/pt/guide/pdf-to-png",
			"/pt/guide/pdf-to-text",
			"/pt/guide/image-to-pdf",
			"/pt/guide/merge-pdf",
			"/pt/guide/split-pdf",
			"/pt/guide/rotate-pdf",
			"/pt/guide/compress-pdf",
			"/pt/privacy-policy",
			"/pt/terms",
			"/pt/licenses",
			"/id",
			"/id/pdf",
			"/id/pdf/to-jpg",
			"/id/pdf/to-png",
			"/id/pdf/to-text",
			"/id/pdf/merge",
			"/id/pdf/split",
			"/id/pdf/rotate",
			"/id/pdf/compress",
			"/id/pdf/image-to-pdf",
